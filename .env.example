# Sayt ünvanı (sitemap, SEO üçün)
NEXT_PUBLIC_SITE_URL=https://luxmebelaz.com

# Supabase (Auth, sifarişlər və sorğular — src/lib/supabase/, src/lib/db.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnız server tərəfində istifadə olunmalıdır, heç vaxt NEXT_PUBLIC_ ilə başlamasın
SUPABASE_SERVICE_ROLE_KEY=

# imgbb (admin paneldən şəkil yükləmə üçün — yalnız server tərəfində)
IMGBB_API_KEY=

# Admin panelə (/admin) giriş icazəsi olan e-poçtlar, vergüllə ayrılır.
# Hesabın özü Supabase → Authentication → Users bölməsində yaradılır.
ADMIN_EMAILS=

# LEO Bank virtual POS (onlayn kart ödənişi — src/lib/payments/leobank.ts). Yalnız server tərəfində.
# Adapter bankın sənədlərinə uyğun tamamlanana qədər "Onlayn kartla" seçimi saytda görünmür.
LEOBANK_API_URL=
LEOBANK_MERCHANT_ID=
LEOBANK_API_KEY=
LEOBANK_SECRET=
