# Sayt ünvanı (sitemap, SEO üçün)
NEXT_PUBLIC_SITE_URL=https://luxmebelaz.com

# Supabase (Auth, sifarişlər və sorğular — src/lib/supabase/, src/lib/db.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnız server tərəfində istifadə olunmalıdır, heç vaxt NEXT_PUBLIC_ ilə başlamasın
SUPABASE_SERVICE_ROLE_KEY=

# imgbb (admin paneldən şəkil yükləmə üçün — yalnız server tərəfində)
IMGBB_API_KEY=

# Admin panelə (/admin) giriş icazəsi olan e-poçtlar, vergüllə ayrılır.
# Hesabın özü Supabase → Authentication → Users bölməsində yaradılır.
ADMIN_EMAILS=

# Unibank virtual POS (onlayn kart ödənişi — src/lib/payments/unibank.ts). Yalnız server tərəfində.
# Adapter bankın sənədlərinə uyğun tamamlanana qədər "Onlayn kartla" seçimi saytda görünmür.
UNIBANK_API_URL=
UNIBANK_MERCHANT_ID=
UNIBANK_API_KEY=
UNIBANK_SECRET=

# Resend — sifariş/müraciət bildiriş məktubları (src/lib/email.ts). Domen Resend-də təsdiqlənməlidir.
RESEND_API_KEY=
# İstəyə görə: göndərən və bildirişlərin gedəcəyi ünvan (standart: info@luxmebelaz.com)
RESEND_FROM=LuxMebel <info@luxmebelaz.com>
ORDER_NOTIFY_EMAIL=info@luxmebelaz.com
